# Copy this file to ".env" and fill in your own values.
# NEVER commit your real .env file to git or share it with anyone.

# --- Exchange credentials ---
DELTA_API_KEY=
DELTA_API_SECRET=

# true = paper/testnet trading (recommended until you trust the bot)
USE_TESTNET=true

# Where candles/prices are READ from -- defaults to the real exchange so
# the strategy reacts to genuine market movement, even while USE_TESTNET
# above is true and orders are placed on your demo account. Leave as-is
# unless you specifically want the bot to read testnet's own prices too.
MARKET_DATA_BASE_URL=https://api.india.delta.exchange

# true = don't send ANY real orders, just log what the bot WOULD do
DRY_RUN=true

# --- Instrument ---
SYMBOL=BTCUSD
RESOLUTION=1m
CANDLE_LOOKBACK=200

# --- Strategy ---
STRATEGY_MODE=trend
EMA_FAST=5
EMA_SLOW=13
RSI_PERIOD=14
ATR_PERIOD=14
RSI_LONG_MAX=80
RSI_LONG_MIN=50
RSI_SHORT_MIN=20
RSI_SHORT_MAX=50
SL_ATR_MULT=1.0
TP_ATR_MULT=1.5

# --- Risk ---
RISK_PER_TRADE_PCT=1.0
LEVERAGE=5
MAX_DAILY_LOSS_PCT=5.0
COOLDOWN_SECONDS=10
FIXED_SIZE=0

# --- Runtime ---
POLL_SECONDS=2
LOG_FILE=bot.log
