# true = paper/testnet trading (fake money, safe to test)
USE_TESTNET=true

# Reads candles/prices from the REAL exchange (accurate charts), while
# orders still get placed on your demo/testnet account below. This is what
# fixes the "demo charts look different from real market" problem.
MARKET_DATA_BASE_URL=https://api.india.delta.exchange

# true = don't send ANY real orders, just log what the bot WOULD do
# Keep this "true" until you've watched it run safely for a while
DRY_RUN=false

# --- Instrument ---
SYMBOL=BTCUSD
RESOLUTION=5m
CANDLE_LOOKBACK=200

# --- Strategy (fast trend-following scalper) ---
STRATEGY_MODE=a_plus
EMA_FAST=5
EMA_SLOW=13
RSI_PERIOD=14
ATR_PERIOD=14
RSI_LONG_MAX=80
RSI_LONG_MIN=50
RSI_SHORT_MIN=20
RSI_SHORT_MAX=50
SL_ATR_MULT=1.0
TP_ATR_MULT=3

# --- Risk ---
RISK_PER_TRADE_PCT=1.0
LEVERAGE=5
MAX_DAILY_LOSS_PCT=5.0
COOLDOWN_SECONDS=10
FIXED_SIZE=0

# --- Runtime ---
POLL_SECONDS=2
LOG_FILE=bot.log

MARKET_DATA_BASE_URL=https://api.india.delta.exchange
